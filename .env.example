# ===== REQUIRED — Get from external services =====
PRIVATE_KEY=           # EOA private key (hex, 64 chars, with or without 0x prefix). Generate: openssl rand -hex 32
PIMLICO_API_KEY=       # Pimlico bundler + paymaster API key. Get: dashboard.pimlico.io (select BSC Testnet)
TELEGRAM_BOT_TOKEN=    # Telegraf bot token from BotFather on Telegram. Format: 123456789:ABCdef...
TELEGRAM_BOT_USERNAME= # Bot @username without @ sign. Example: defai_mcp_tele_bot
GROQ_API_KEY=          # Groq API key (Llama 3.3 70B / 8B-Instant). Required when LLM_PROVIDER=groq (default).

# ===== REQUIRED — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" =====
ENCRYPTION_KEY=        # Master key for AES-256-GCM encryption of stored private keys. Min 32 chars. Process refuses to start if missing.
JWT_SECRET=            # JWT signing secret for dashboard auth. Min 32 chars. Process refuses to start if missing.

# ===== OPTIONAL =====
BSC_TESTNET_RPC=       # Custom BSC Testnet RPC URL (defaults to public RPC if blank)
MCP_TRANSPORT=         # Transport mode: "stdio" for Claude Desktop (default) or "sse" for HTTP
DEFAI_USER_ID=         # UUID from dashboard registration — used to resume MCP session as existing user
TINYFISH_API_KEY=      # TinyFish web-scraping API key (optional feature)

# ===== LLM provider switch (Phase 7A+) =====
LLM_PROVIDER=          # "groq" (default) or "vertex". Routes every LLM call (planner/verifier/classifier/summarizer/judge) through the chosen stack.
GCP_PROJECT_ID=        # Required when LLM_PROVIDER=vertex.
GCP_LOCATION=          # Vertex region. Default us-central1; asia-south1 for India latency.
VECTOR_MEMORY_PROVIDER= # "stub" (default; dev) or "vertex" (uses gemini-embedding-001).

# ===== Postgres backend (Phase 7C+, optional — SQLite is the default local) =====
# Set ONE of: CLOUD_SQL_CONNECTION_NAME (prod) | POSTGRES_URL | POSTGRES_HOST+...
CLOUD_SQL_CONNECTION_NAME= # Cloud SQL instance ID in PROJECT:REGION:INSTANCE form (auto-attaches Auth Proxy on Cloud Run).
POSTGRES_URL=          # Full libpq connection string (used outside Cloud Run).
POSTGRES_HOST=
POSTGRES_PORT=         # default 5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_MAX_POOL=     # default 10

# ===== Cloud Run / production telegram webhook (Phase 7E+) =====
PORT=                  # Cloud Run injects 8080; local dev defaults to 3002
TELEGRAM_MODE=         # "polling" (local default) or "webhook" (required on Cloud Run since scale-to-zero kills polling)
TELEGRAM_WEBHOOK_SECRET= # Telegram's secret_token header value — defense-in-depth on top of the token-in-path scheme
TELEGRAM_WEBHOOK_URL=  # Optional: when set, the app auto-calls Telegram setWebhook on boot

# ===== TUNABLES =====
SCRYPT_N=              # Override scrypt cost (default 131072 = 2^17, ~128MB / 400ms). Lower for tests/dev (e.g. 16384).
DISABLE_INTENT_ROUTING= # Set to "1" to bypass intent-routed model tiering and always use the flagship planner.
DISABLE_VERIFIER=      # Set to "1" to bypass the Layer-3 verifier sub-agent. Tests + incident escape hatch only.

# ===== FLOW (local dev) =====
# 1. Fill in REQUIRED fields above (Groq path keeps everything default).
# 2. npm run dev
# 3. Open dashboard at http://localhost:5173
# 4. Register with your PRIVATE_KEY → get DEFAI_USER_ID
# 5. Add DEFAI_USER_ID to Claude config for MCP mode
# 6. Use DEFAI_USER_ID with /connect in Telegram bot

# ===== FLOW (Cloud Run deploy) =====
# See docs/DEPLOY.md — one-time GCP setup (project / Cloud SQL / Secret Manager / IAM)
# then `gcloud builds submit --config=cloudbuild.yaml`.
