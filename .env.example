# ===== REQUIRED — Get from external services =====
PRIVATE_KEY=           # EOA private key (hex, 64 chars, with or without 0x prefix). Generate: openssl rand -hex 32
PIMLICO_API_KEY=       # Pimlico bundler + paymaster API key. Get: dashboard.pimlico.io (select BSC Testnet)
TELEGRAM_BOT_TOKEN=    # Telegraf bot token from BotFather on Telegram. Format: 123456789:ABCdef...
TELEGRAM_BOT_USERNAME= # Bot @username without @ sign. Example: defai_mcp_tele_bot
GROQ_API_KEY=          # Groq API key for Llama 3.3 70B. Get: console.groq.com/keys

# ===== REQUIRED — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" =====
ENCRYPTION_KEY=        # Master key for AES-256-GCM encryption of stored private keys. Min 32 chars. Process refuses to start if missing.
JWT_SECRET=            # JWT signing secret for dashboard auth. Min 32 chars. Process refuses to start if missing.

# ===== OPTIONAL =====
BSC_TESTNET_RPC=       # Custom BSC Testnet RPC URL (defaults to public RPC if blank)
MCP_TRANSPORT=         # Transport mode: "stdio" for Claude Desktop (default) or "sse" for HTTP
DEFAI_USER_ID=         # UUID from dashboard registration — used to resume MCP session as existing user
TINYFISH_API_KEY=      # TinyFish web-scraping API key (optional feature)

# ===== TUNABLES =====
SCRYPT_N=              # Override scrypt cost (default 131072 = 2^17, ~128MB / 400ms). Lower for tests/dev (e.g. 16384).

# ===== FLOW =====
# 1. Fill in all REQUIRED fields above
# 2. Run: npm run dev
# 3. Open dashboard at http://localhost:5173
# 4. Register with your PRIVATE_KEY → get DEFAI_USER_ID
# 5. Add DEFAI_USER_ID to Claude config for MCP mode
# 6. Use DEFAI_USER_ID with /connect in Telegram bot
